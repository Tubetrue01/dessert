config AdGuardHome 'AdGuardHome'
	option enabled '0'
	option htt_pport '3000'
	option redirect 'none'
	option config_path '/etc/AdGuardHome.yaml'
	option work_dir '/opt/data/AdGuardHome'
	option log_file '/tmp/AdGuardHome.log'
	option verbose '0'
	option bin_path '/usr/bin/AdGuardHome'
	option upx_flag ''
	option work_dir_backup '/opt/data/AdGuardHome/backup'
	option arch ''
	option version_type ''
	option backup_files 'filter status.db'

config AdGuardHome 'UpdateLinks'
	list url 'https://static.adguard.com/adguardhome/release/AdGuardHome_linux_${Arch}.tar.gz'
	list url '#https://static.adguard.com/adguardhome/beta/AdGuardHome_linux_${Arch}.tar.gz'
	list url 'https://github.com/AdguardTeam/AdGuardHome/releases/download/${latest_ver}/AdGuardHome_linux_${Arch}.tar.gz'





