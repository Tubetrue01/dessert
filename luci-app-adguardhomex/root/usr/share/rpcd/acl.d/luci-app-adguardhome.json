{
  "luci-app-adguardhome": {
    "description": "控制 AdGuardHome 插件的所有权限",
    "read": {
      "uci": [
        "AdGuardHome"
      ],
      "file": {
        "*.log": [
          "read"
        ],
        "*.yaml":[
          "read"
        ]
      },
      "ubus": {
        "luci.adguardhome": [
          "currentVersion"
        ],
        "service": [ "list" ]
      }
    },
    "write": {
      "uci": [
        "AdGuardHome"
      ],
      "ubus": {
        "luci.adguardhome": [
          "clearLog",
          "updateCore"
        ]
      },
       "file":{
          "*.yaml":[
            "write"
          ],
          "/tmp/AdGuardHome_update.log":[
            "write"
          ],
        "/usr/share/adguardhome/adguardhome.uc": ["exec"],
        "/etc/init.d/AdGuardHome": ["exec"]
        }
    }
  }
}

