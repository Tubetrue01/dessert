{
  "luci-app-adguardhome": {
    "description": "控制 AdGuardHome 插件的所有权限",
    "read": {
      "uci": [
        "AdGuardHome"
      ],
      "file": {
        "*.log": [
          "read"
        ],
        "*.yaml":[
          "read"
        ]
      }
    },
    "write": {
      "uci": [
        "AdGuardHome"
      ],
      "ubus": {
        "luci.adguardhome": [
          "clearLog"
        ]
      },
       "file":{
          "*.yaml":[
            "write"
          ],
          "/tmp/AdGuardHome_update.log":[
            "write"
          ]
        }
    }
  }
}

