
'use strict';

import { stat, mkdir, chmod, popen } from 'fs';

function sanitize_path(path) {
    return !(!path || index(path || "", "..") !== -1);

}

function run_cmd(command_array) {
    if (type(system) === "function") {
        return system(command_array);
    }

    const cmd_str = join(" ", command_array);
    const p = popen(cmd_str);

    if (p) {
        return p.close();
    }

    return -1;
}

const methods = {
    install: {
        args: { filename: "filename" },
        call: function(req) {
            const file = req.args.filename;

            if (!file || !stat(file)) {
                return { code: 1, message: "File not found" };
            }

            let rc;
            const suffix = substr(file, -4);

            if (suffix == ".ipk") {
                rc = system(['opkg', 'install', file]);
            }

            if (suffix == ".apk") {
                rc = system(['apk', 'add', '--allow-untrusted', file]);
            }

            return {
               code: rc,
               message: rc === 0 ? "Installation successful" : "Installation failed"
            };
        }
    },

 rename: {
        args: { oldName: "oldName", newName: "newName" },
        call: function(req) {
            const old_path = req.args.oldName;
            const new_path = req.args.newName;

            if (!sanitize_path(old_path) || !sanitize_path(new_path)) {
                return { code: 255, message: "Security violation: Invalid path" };
            }

            if (!stat(old_path)) {
                return { code: 1, message: "Source file not found" };
            }

            const rc = run_cmd(['mv', old_path, new_path]);

            if (rc === 0) {
                chmod(new_path, 0o644);
                return { code: 0, message: "Rename successful" };
            } else {
                return { code: 1, message: "Rename failed with code " + rc };
            }
        }
    },
    mkdirUpload: {
        args: { uploadPath: "uploadPath" },
        call: function(req) {
            const up_path = req.args.uploadPath;

            if (up_path && mkdir(up_path, 0o755)) {
                return { code: 0, message: "Directory created" };
            } else {
                return { code: 1, message: "Failed to create directory" };
            }
        }
    }
};

return { "luci.filemanager": methods };
