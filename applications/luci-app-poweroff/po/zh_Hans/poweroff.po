msgid "PowerOff"
msgstr "关机"

msgid "Shutting down…"
msgstr "正在关机…"

msgid "Device is shutting down…"
msgstr "关机中，说啥也不好使了…"

msgid "Proceed"
msgstr "关机，走你～"

msgid "WARNING: May cause a reboot on a device that does not support power off."
msgstr "吹灯拔蜡，关机回家"

msgid "Warning: There are unsaved changes that will get lost on poweroff!"
msgstr "警告：没保存的改动在关机的时候都会丢失！别惊讶，要么保存，要么放弃！"

msgid "Warning: This device does not support powering off!"
msgstr "警告：设备不支持关机！"
