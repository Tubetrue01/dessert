{
  "luci-app-filemanager": {
    "description": "FileManager minimal ACL",
    "read": {
      "file": {
        "/*": [ "read", "list" ]
      },
      "ubus": {
        "file": ["list", "read", "stat"],
        "fs": [ "read", "list", "stat" ]
      }
    },
    "write": {
      "file": {
        "/tmp/upload/*": ["write", "remove"]
      },
      "ubus": {
        "file": ["write", "remove"],
        "luci.filemanager": ["install", "rename", "mkdirUpload"]
      }
    }
  }
}