#!/bin/sh

. /usr/share/libubox/jshn.sh

sanitize_path() {
    local path="$1"
    case "$path" in
        *..*) return 1 ;;
    esac
    return 0
}

msg_json() {
    json_init
    json_add_int "code" "$1"
    json_add_string "message" "$2"
    json_dump
    json_cleanup
}

case "$1" in
"list")
    json_init
    json_add_object "install"
        json_add_string "filename" "filename"
    json_close_object
    json_add_object "rename"
        json_add_string "oldName" "oldName"
        json_add_string "newName" "newName"
    json_close_object
    json_add_object "mkdirUpload"
        json_add_string "uploadPath" "uploadPath"
    json_close_object
    json_dump
    json_cleanup
    ;; 
call)
    case "$2" in

    install)
        read -r input
        json_load "$input"
        json_get_var ipk_file "filename"
        json_cleanup

        if [ ! -f "$ipk_file" ]; then
            msg_json 1 "File not found"
            exit 1
        fi

        if opkg install "$ipk_file" >/dev/null 2>&1; then
            msg_json 0 "Installation successful"
        else
            msg_json 1 "Installation failed"
            exit 1
        fi
        ;;

    rename)
        read -r input
        json_load "$input"
        json_get_var old "oldName"
        json_get_var new "newName"
        json_cleanup

        if ! sanitize_path "$old" || ! sanitize_path "$new"; then
            msg_json 255 "Security violation: Invalid path"
            exit 255
        fi

        if [ ! -f "$old" ]; then
            msg_json 1 "Source file not found"
            exit 1
        fi

        if mv "$old" "$new" 2>/dev/null; then
            chmod 0644 "$new"
            msg_json 0 "Rename successful"
        else
            msg_json 1 "Rename failed"
        fi
        ;;

    mkdirUpload)
        read -r input
        json_load "$input"
        json_get_var upload_path "uploadPath"
        json_cleanup

        if mkdir -p "$upload_path"; then
            msg_json 0 "Directory created"
        else
            msg_json 1 "Failed to create directory"
        fi
        ;;

    *)
        msg_json 1 "Unknown method: $2"
        exit 1
        ;;
    esac
    ;;

*)
    msg_json 1 "Unknown command: $1"
    exit 1
    ;;
esac