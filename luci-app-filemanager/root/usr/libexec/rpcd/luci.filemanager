#!/usr/bin/ucode

import { readfile, popen } from 'fs';

function sanitize_path(path) {
    if (!path || index(path, "..") != -1) {
        return false;
    }
    return true;
}

function msg_json(code, message) {
    print(push({}, {
        code: code,
        message: message
    }));
}

function get_input() {
    let raw = stdin.read("all");
    return json(raw);
}

const cmd = ARGV[0];
const method = ARGV[1];

switch (cmd) {
    case "list":
        /* 定义接口参数结构 */
        print({
            install: { filename: "filename" },
            rename: { oldName: "oldName", newName: "newName" },
            mkdirUpload: { uploadPath: "uploadPath" }
        });
        break;

    case "call":
        let args = get_input();

        switch (method) {
            case "install":
                let ipk = args?.filename;
                if (!ipk || system(['test', '-f', ipk]) != 0) {
                    msg_json(1, "File not found");
                    exit(1);
                }

                if (system(['opkg', 'install', ipk]) == 0) {
                    msg_json(0, "Installation successful");
                } else {
                    msg_json(1, "Installation failed");
                    exit(1);
                }
                break;

            case "rename":
                let old_path = args?.oldName;
                let new_path = args?.newName;

                if (!sanitize_path(old_path) || !sanitize_path(new_path)) {
                    msg_json(255, "Security violation: Invalid path");
                    exit(255);
                }

                if (system(['mv', old_path, new_path]) == 0) {
                    system(['chmod', '0644', new_path]);
                    msg_json(0, "Rename successful");
                } else {
                    msg_json(1, "Rename failed");
                }
                break;

            case "mkdirUpload":
                let up_path = args?.uploadPath;
                if (up_path && system(['mkdir', '-p', up_path]) == 0) {
                    msg_json(0, "Directory created");
                } else {
                    msg_json(1, "Failed to create directory");
                }
                break;

            default:
                msg_json(1, "Unknown method: " + (method || "none"));
                exit(1);
        }
        break;

    default:
        msg_json(1, "Unknown command: " + (cmd || "none"));
        exit(1);
}