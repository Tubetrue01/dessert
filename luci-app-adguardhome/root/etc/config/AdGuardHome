config AdGuardHome 'AdGuardHome'
	option enabled '0'
	option http_port '3000'
	option redirect 'none'
	option config_path '/etc/AdGuardHome/AdGuardHome.yaml'
	option work_dir '/tmp/AdGuardHome'
	option log_file '/tmp/AdGuardHome/AdGuardHome.log'
	option verbose '0'
	option bin_path '/usr/bin/AdGuardHome'
	option upx_flag ''
	option work_dir_backup '/tmp/AdGuardHome/backup'
	option arch ''
	option version_type ''
	list backup_files 'filters'
	list backup_files 'querylog.json'
	list backup_files 'querylog.json.1'

config AdGuardHome 'UpdateLinks'
	list url 'https://static.adguard.com/adguardhome/release/AdGuardHome_linux_${Arch}.tar.gz'
	list url 'https://github.com/AdguardTeam/AdGuardHome/releases/download/${latest_ver}/AdGuardHome_linux_${Arch}.tar.gz'





