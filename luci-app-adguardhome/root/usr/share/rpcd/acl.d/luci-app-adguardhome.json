{
  "luci-app-adguardhome": {
    "description": "Grant UCI access for luci-app-adguardhome",
    "read": {
      "uci": [
        "AdGuardHome"
      ],
      "file": {
        "*.log": [
          "read"
        ],
        "*.yaml":[
          "read"
        ]
      },
      "ubus": {
        "luci.adguardhome": [
          "currentVersion",
          "readLog",
          "reload"
        ],
        "service": [ "list" ]
      }
    },
    "write": {
      "uci": [
        "AdGuardHome"
      ],
      "ubus": {
        "luci.adguardhome": [
          "clearLog",
          "updateCore"
        ]
      },
       "file":{
          "*.yaml":[
            "write"
          ]
        }
    }
  }
}

