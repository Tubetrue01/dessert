'use strict';

import {popen, stat, writefile} from 'fs';

const uci = require("uci").cursor();

const service_name = "AdGuardHome";

function _exec_sys(cmd) {
    const p = popen(`sh -c '${cmd}' 2>&1`, "r");
    if (!p) {
        return {code: -1, data: ""};
    }

    const stdout = p.read("all");
    const code = p.close();

    return {
        code: code,
        data: (type(stdout) === "string") ? trim(stdout) : ""
    };
}

const methods = {
    clearLog: {
        args: {filename: "filename"},
        call: function (req) {
            const filename = req.args.filename;

            if (!filename) {
                return {code: 1, error: "No filename specified"};
            }

            if (filename !== "syslog") {
                writefile(filename, "");
            }
            return {code: 0, message: "File cleared", path: filename}
        }
    },

    readLog: {
        args: {filename: "filename", count: "count"},
        call: function (req) {
            const filename = req.args.filename;
            const count = req.args.count || "200";

            if (filename === "syslog") {
                const res = _exec_sys(`/sbin/logread -l ${count} -e ${service_name}`);
                return {code: 0, data: res.data};
            } else {
               if (!filename) {
                  return { code: 1, data: "No filename" };
               }

               if (!stat(filename)) {
                  return { code: 0, data: "" };
               }

               const cmd = `tr -d '\\000' < "${filename}" | tail -n ${count}`;
               const p = popen(cmd, "r");

               let content = "";
               if (p) {
                   content = p.read("all");
                   p.close();
               }

               return {
                   code: 0,
                   data: (type(content) === "string") ? trim(content) : ""
               };
            }
        }
    },

    updateCore: {
        call: function () {
            const file_log = "/tmp/AdGuardHome_update.log";

            writefile(file_log, "");

            const script_path = "/usr/share/adguardhome/adguardhome.uc";
            const cmd = `ucode ${script_path} update ${file_log} &`;

            const res = system(cmd);

            if (res === 0) {
                return {code: 0, message: "success", command: cmd};
            } else {
                return {code: 1, error: "failed", exit_code: res};
            }
        }
    },
    currentVersion: {
        call: function () {
            try {
                let bin_path = uci.get(service_name, service_name, "bin_path");

                if (!bin_path || !stat(bin_path)) {
                    return {"code": 1, "data": "missing"};
                }

                let p = popen(`${bin_path} --version`);
                let stdout = (p ? p.read("all") : "") || "";

                if (p) {
                    p.close();
                }

                let re = regexp("version\\s+([^\\s,]+)");
                let m = match(stdout, re);

                return {
                    "code": 0,
                    "data": (m && m[1]) ? trim(m[1]) : "unknown"
                };
            } catch (e) {
            }
        }
    }
};

return {"luci.adguardhome": methods};
