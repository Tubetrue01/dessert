'use strict';

const fs = require('fs');
const uci = require("uci").cursor();

const service_name = "AdGuardHome";

const methods = {
    clearLog: {
        args: { filename: "filename" },
        call: function(req) {
            const filename = req.args.filename;

            if (!filename) {
                return { code: 1, error: "No filename specified" };
            }

            const fd = fs.open(filename, "w");

            if (fd) {
                fd.close(); 
                return { code: 0, message: "File has been successfully cleared", path: filename };
            } else {
                return { code: 1, error: "Unable to open the file for writing", path: filename };
            }
        }
    },

    readLog: {
        args: { filename: "filename", count: "count" },
        call: function(req) {
            const filename = req.args.filename;
            const count = req.args.count || "200";

            let logContent = "";

            if (filename === "") {

            } else if (filename === "syslog") {
                 const res = fs.exec("/sbin/logread", ["-l", count, "-e", service_name]);
                 logContent = res ? res.stdout : "";
            }else {
                if (fs.stat(filename)) {
                    const res = fs.exec("/usr/bin/tail", ["-n", count, filename]);
                    logContent = res ? res.stdout : "";
                } else {
                    logContent = "Log file not found.";
                }
            }
        }
        return { code: 0, data: logContent}
    },

    updateCore: {
        call: function() {
            const file_log = "/tmp/AdGuardHome_update.log";

            const f = fs.open(file_log, "w"); 
            if (f){
                f.close();
            } 

            const script_path = "/usr/share/adguardhome/adguardhome.uc";
            const cmd = `ucode ${script_path} update ${file_log} &`;
            
            const res = system(cmd);

            if (res === 0) {
                return { code: 0, message: "success", command: cmd };
            } else {
                return { code: 1, error: "failed", exit_code: res };
            }
        }
    },
    currentVersion: {
        call: function() {
             try {
                let bin_path = uci.get(service_name, service_name, "bin_path");
                
                if (!bin_path || !fs.stat(bin_path)) {
                    return { "code": 1, "data": "missing" };
                }

                let p = fs.popen(`${bin_path} --version`);
                let stdout = (p ? p.read("all") : "") || ""; 
                
                if (p) {
                    p.close();
                }

                 let re = regexp("version\\s+([^\\s,]+)");
                 let m = match(stdout, re);
                
                return { 
                    "code": 0, 
                    "data": (m && m[1]) ? trim(m[1]) : "unknown" 
                };
            } catch (e) {
            }
        }
    }
};

return { "luci.adguardhome": methods };
