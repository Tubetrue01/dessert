config frpc 'common'
    option enabled '1'
    option config_path '/etc/frpc'
    option serverAddr ''
    option serverPort ''
    option auth_method ''
    option auth_token ''
    list auth_additionalScopes 'HeartBeats'
    list auth_additionalScopes 'NewWorkConns'
    option user 'OpenWrt'
    option log_level 'info'
    option log_maxDays '3'
    option log_to '/tmp/frpc.log'
    option transport_protocol 'tcp'
    option transport_tls_certFile ''
    option transport_tls_keyFile ''
    option transport_tls_trustedCaFile ''
    option transport_tls_serverName ''
    option transport_poolCount "1"
    option transport_tcpMux "true"
    option transport_tls_enable 'true'
    option loginFailExit 'false'
    list includes '/var/etc/frp/frpc/confd/*.toml'


config proxy
    option enabled '1'
    option remark 'town-op'
    option type 'https'
    list custom_domains 'town-op.loveanv.top"'
    option transport_useEncryption 'true'
    option transport_useCompression 'true'
    option healthCheck_type 'tcp'
    option healthCheck_timeoutSeconds '3'
    option healthCheck_maxFailed '3'
    option healthCheck_intervalSeconds '10'
    option localIP "172.31.0.1"
    option localPort '80'
    option plugin_type 'https2http'
    option plugin_localAddr '172.31.0.1:80'
    option plugin_crtPath ''
    option plugin_keyPath ''
    option plugin_hostHeaderRewrite ''
    option plugin_requestHeaders_set_x__from__where 'frp'

config proxy
    option enabled '1'
    option remark 'town-ssh'
    option type 'tcp'
    option transport_useEncryption 'true'
    option transport_useCompression 'true'
    option healthCheck_type 'tcp'
    option healthCheck_timeoutSeconds '3'
    option healthCheck_maxFailed '3'
    option healthCheck_intervalSeconds '10'
    option remotePort '15030'
    option localIP '172.31.0.1'
    option localPort '22'