{
  "luci-app-frpc": {
    "description": "Grant UCI access for luci-app-frpc",
    "read": {
      "file": {
        "/etc/frpc/frpc.yaml": [
          "read"
        ],
        "/tmp/frpc_update.log": [
          "read"
        ]
      },
      "uci": [
        "frpc"
      ],
      "ubus": {
        "luci.frpc": [
          "currentVersion"
        ],
        "service": [
          "list"
        ]
      }
    },
    "write": {
      "file": {
        "/etc/frpc/frpc.yaml": [
          "write"
        ],
        "/etc/init.d/frpc": [
          "exec"
        ]
      },
      "uci": [
        "frpc"
      ],
      "ubus": {
        "luci.frpc": [
          "clearLog",
          "updateCore"
        ]
      }
    }
  }
}
