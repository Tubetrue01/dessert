'use strict';

import {popen, stat} from 'fs';

function _exec_sys(cmd) {
    const p = popen(`sh -c '${cmd}' 2>&1`, "r");
    if (!p) {
        return {code: -1, data: ""};
    }

    const stdout = p.read("all");
    const code = p.close();

    return {
        code: code,
        data: (type(stdout) === "string") ? trim(stdout) : ""
    };
}

const methods = {
    clearLog: {
        args: {filename: "filename"},
        call: function (req) {
            const filename = req.args.filename;

            if (!filename) {
                return {code: 1, error: "No filename specified"};
            }

            _exec_sys(`echo > "${filename}"`);

            return {code: 0, message: "File has been successfully cleared", path: filename};
        }
    },
    updateCore: {
        call: function () {
            const file_log = "/tmp/frpc_update.log";

            _exec_sys(`echo > "${file_log}"`);

            const script_path = "/usr/share/frpc/frpc.uc";
            const cmd = `ucode ${script_path} update ${file_log} &`;

            const res = system(cmd);

            if (res === 0) {
                return {code: 0, message: "success", command: cmd};
            } else {
                return {code: 1, error: "failed", exit_code: res};
            }
        }
    },
    currentVersion: {
        call: function () {
            try {
                const bin_path = "/usr/bin/frpc";

                if (!bin_path || !stat(bin_path)) {
                    return {"code": 1, "data": "missing"};
                }

                const p = popen(`${bin_path} -v`);
                const stdout = (p ? p.read("all") : "") || "";

                if (p) {
                    p.close();
                }

                return {
                    "code": 0,
                    "data": stdout ? trim(stdout) : "unknown"
                };
            } catch (e) {
            }
        }
    }
};

return {"luci.frpc": methods};
